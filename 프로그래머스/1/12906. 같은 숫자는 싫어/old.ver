import java.util.*;

public class Solution {
    public int[] solution(int []arr) {
        /*
            1. arr을 처음부터 끝까지 조회
            2. 조회하면서 이전 숫자와 동일하면 제거
            -> 배열이 정적인 구조라서 동적으로 제거가 안됨!
            -> 이전 숫자와 동일하지 않을 경우 리스트에 넣는 걸로 변경
            3. 리스트를 배열로 변환하여 제출(toArray는 String일때만 가능)
        */    
        List<Integer> numList = new ArrayList<>();
        
        for(int i=0; i<arr.length; i++){
            if(i == 0) numList.add(arr[0]);
            else if(arr[i] != arr[i-1]) numList.add(arr[i]);                     
        }
            
        int listSize = numList.size();
        int[] answer = new int[listSize];
        
        for(int i=0; i<listSize; i++){
            answer[i] = numList.get(i);
        }
        
        return answer;
    }
}
